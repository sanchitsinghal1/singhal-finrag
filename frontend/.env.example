# ============================================================================
# Singhal FinRAG — Frontend Environment (Next.js)
# ============================================================================
# Copy this file to frontend/.env. The frontend itself does NOT talk to the
# database or AI — it only renders UI and proxies API calls to the backend.

# Where the Next.js dev server proxies /api/* requests to.
# This is your Express backend URL. In development: http://127.0.0.1:3001
# In production: your deployed backend URL (e.g. https://api.yourdomain.com)
BACKEND_URL=http://127.0.0.1:3001
