# ============================================================================
# Singhal FinRAG — Root Environment (orchestrator)
# ============================================================================
# This file is read by the root package.json scripts only. The backend reads
# backend/.env and the frontend reads frontend/.env. Copy to .env at root.

# Passed to the backend process so it can connect to MongoDB + sign JWTs.
MONGODB_URI=mongodb://127.0.0.1:27017/singhal_finrag
MONGODB_DB_NAME=
JWT_SECRET=dev-only-secret-change-me-please-use-a-long-random-string
PORT=3001

# Passed to the frontend so it knows where to proxy /api/* .
BACKEND_URL=http://127.0.0.1:3001
NODE_ENV=development
