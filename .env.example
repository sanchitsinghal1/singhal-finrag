# Singhal FinRAG — environment variables (NO real secrets here; copy to .env)

# ---- Backend (Express + MongoDB) ----
# MongoDB connection string. Local MongoDB:
#   mongodb://127.0.0.1:27017/singhal_finrag
# MongoDB Atlas (production):
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/singhal_finrag

# Optional: override the database name (useful with Atlas where the name is
# usually encoded in the URI). Leave blank to use the URI's default.
MONGODB_DB_NAME=

# JWT signing secret — REQUIRED for production. Generate with:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Backend port (the Next.js frontend proxies /api/* here). Default 3001.
PORT=3001

# ---- Frontend (Next.js) ----
# Where the frontend proxies /api/* to. Defaults to http://127.0.0.1:3001.
# In production, set this to your deployed backend URL.
BACKEND_URL=http://127.0.0.1:3001

# Node environment
NODE_ENV=development
