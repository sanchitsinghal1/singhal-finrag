# ============================================================================
# Singhal FinRAG — Backend Environment (Express + MongoDB + Auth)
# ============================================================================
# Copy this file to backend/.env and fill in real values.
# This file is safe to commit; .env (without .example) is gitignored.

# ----------------------------------------------------------------------------
# MongoDB connection string — REQUIRED
# ----------------------------------------------------------------------------
# LOCAL MongoDB (what you run on your laptop for development):
#   Start mongod first:  mongod --dbpath ./data --port 27017 --bind_ip 127.0.0.1
#   Then use this connection string:
MONGODB_URI=mongodb://127.0.0.1:27017/singhal_finrag

# MongoDB Atlas (production / cloud) — get this from Atlas → Connect → Drivers:
#   mongodb+srv://<username>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Paste your Atlas string below instead of the local one when deploying.
# MONGODB_URI=mongodb+srv://youruser:yourpassword@cluster0.mongodb.net/?retryWrites=true&w=majority

# Database name — OPTIONAL
# Leave blank to use the name encoded in MONGODB_URI (singhal_finrag for local).
# For Atlas, the URI usually has no DB name, so set it explicitly:
MONGODB_DB_NAME=

# ----------------------------------------------------------------------------
# Auth — JWT signing secret — REQUIRED for production
# ----------------------------------------------------------------------------
# The backend signs session JWTs with this. Anyone who knows it can forge
# sessions, so keep it secret. Generate a strong one with:
#   openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-please-use-a-long-random-string

# ----------------------------------------------------------------------------
# Server config
# ----------------------------------------------------------------------------
# Port the Express backend listens on. The Next.js frontend proxies /api/*
# here via next.config.js rewrites. Don't change unless you also update
# frontend/.env BACKEND_URL.
PORT=3001

# production = tighter cookie handling, no stack traces in errors, etc.
NODE_ENV=development
